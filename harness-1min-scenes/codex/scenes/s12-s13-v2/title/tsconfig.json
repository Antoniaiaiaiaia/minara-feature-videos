{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] },
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
